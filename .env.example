# apps/crew-mobile (.env, EXPO_PUBLIC_-prefixed — inlined into the client bundle, no secrets)
EXPO_PUBLIC_EDGE_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1

# apps/admin-web
VITE_EDGE_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1

# Supabase Edge Functions secrets (set via `supabase secrets set` or the dashboard)
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are auto-injected by the platform — do not set manually.
CREW_ADMIN_PIN=change-me
